# Railway inyecta DATABASE_URL solo al añadir el plugin PostgreSQL al proyecto.
# Para desarrollo local, copia este archivo a .env y ajusta los valores.
DATABASE_URL=postgres://usuario:contrasena@localhost:5432/safety_rounds

# Contraseña compartida por los usuarios ficticios que se crean la primera
# vez que arranca el servidor (solo si la tabla de usuarios está vacía).
SEED_USERS_PASSWORD=Rondas2026!

# Administrador real: usuario/correo y contraseña. Si no defines ADMIN_PASSWORD,
# se genera una al azar en el primer arranque y se escribe una vez en los logs.
ADMIN_EMAIL=mou5nch@gmail.com
ADMIN_PASSWORD=

# Correo saliente para "¿Has olvidado tu contraseña?" (con Gmail, usa una
# contraseña de aplicación: myaccount.google.com/apppasswords). Sin esto
# configurado, esa opción no envía nada.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Puerto local (Railway define PORT automáticamente en producción).
PORT=3000
