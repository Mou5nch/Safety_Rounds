# En Railway: añade el plugin PostgreSQL al proyecto y usa una referencia al
# servicio, no una URL suelta — así apunta siempre al Postgres real en vez de
# a este valor de ejemplo (que Railway podría sugerirte tal cual si no lo
# cambias). Si tu servicio de Postgres no se llama "Postgres", ajusta el nombre.
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Para desarrollo local (fuera de Railway), sustituye la línea de arriba por
# una URL real, por ejemplo:
# DATABASE_URL=postgres://usuario:contrasena@localhost:5432/safety_rounds

# La URL interna de Railway entre servicios del mismo proyecto no usa SSL.
# Solo pon esto a "true" si DATABASE_URL apunta a un Postgres externo
# (Supabase, RDS…) que sí lo exija.
PGSSL=false

# Contraseña compartida por los usuarios ficticios que se crean la primera
# vez que arranca el servidor (solo si la tabla de usuarios está vacía).
SEED_USERS_PASSWORD=Rondas2026!

# Administrador real: usuario/correo y contraseña. Si no defines ADMIN_PASSWORD,
# se genera una al azar en el primer arranque y se escribe una vez en los logs.
ADMIN_EMAIL=mou5nch@gmail.com
ADMIN_PASSWORD=

# Correo saliente para "¿Has olvidado tu contraseña?" (con Gmail, usa una
# contraseña de aplicación: myaccount.google.com/apppasswords). Sin esto
# configurado, esa opción no envía nada.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Puerto local (Railway define PORT automáticamente en producción).
PORT=3000
